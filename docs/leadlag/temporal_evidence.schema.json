{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://institutional-signal-engine.invalid/leadlag/temporal-evidence-v1.json",
  "title": "Lead/Lag Temporal Evidence",
  "type": "object",
  "required": ["receipt_id", "source", "symbol", "provenance", "duplicate", "out_of_order"],
  "properties": {
    "receipt_id": {"type": "string"},
    "source": {"type": "string"},
    "symbol": {"type": "string"},
    "instrument": {"type": ["string", "null"]},
    "provider_event_timestamp": {"type": ["string", "null", "object"]},
    "provider_sequence": {"type": ["integer", "string", "null"]},
    "received_wall_timestamp": {"type": ["string", "null", "object"]},
    "received_monotonic_ns": {"type": ["integer", "null"]},
    "normalization_timestamp": {"type": ["string", "null", "object"]},
    "canonical_acceptance_timestamp": {"type": ["string", "null", "object"]},
    "processing_timestamp": {"type": ["string", "null", "object"]},
    "emission_timestamp": {"type": ["string", "null", "object"]},
    "timestamp_precision": {"type": ["string", "null"]},
    "timestamp_uncertainty_ns": {"type": ["integer", "null"]},
    "provenance": {"type": "string"},
    "duplicate": {"type": "boolean"},
    "out_of_order": {"type": "boolean"}
  },
  "additionalProperties": false
}
