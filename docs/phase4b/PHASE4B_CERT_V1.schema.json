{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PHASE4B_CAUSAL_CERT_V2",
  "type": "object",
  "required": [
    "certification_version", "evidence_kind", "run_id", "journal",
    "configuration_versions", "epochs", "subscriptions", "events", "clock",
    "recovery", "persistence", "replay", "orders", "invariants",
    "failed_invariants", "overall"
  ],
  "properties": {
    "certification_version": {"const": "PHASE4B_CAUSAL_CERT_V2"},
    "evidence_kind": {"const": "RUNTIME_CERTIFICATE"},
    "run_id": {"type": "string", "format": "uuid"},
    "journal": {
      "type": "object",
      "required": ["record_count", "terminal_sequence", "terminal_digest", "seal_digest"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 1},
        "terminal_sequence": {"type": "integer", "minimum": 0},
        "terminal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "seal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "configuration_versions": {
      "type": "object",
      "required": ["scenario", "control_model", "shadow_model", "coverage"],
      "additionalProperties": {"type": "string"}
    },
    "epochs": {"type": "array", "minItems": 3, "maxItems": 3},
    "subscriptions": {"type": "array", "minItems": 6},
    "events": {
      "type": "object",
      "required": ["accepted", "rejected"],
      "properties": {
        "accepted": {"type": "array", "minItems": 1},
        "rejected": {"type": "array", "minItems": 1}
      },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "required": ["advancements", "reevaluations"],
      "properties": {
        "advancements": {"const": 2},
        "reevaluations": {"const": 2}
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["disconnects", "reconnects", "restorations"],
      "properties": {
        "disconnects": {"const": 1},
        "reconnects": {"const": 1},
        "restorations": {"const": 1}
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "required": ["identity", "digest", "queue_depth_final"],
      "properties": {
        "identity": {"type": "string"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "queue_depth_final": {"const": 0}
      },
      "additionalProperties": false
    },
    "replay": {
      "type": "object",
      "required": ["exact_equal", "record_count", "terminal_digest"],
      "properties": {
        "exact_equal": {"const": true},
        "record_count": {"type": "integer", "minimum": 1},
        "terminal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "orders": {
      "type": "object",
      "required": ["trading_enabled", "constructed", "submitted"],
      "properties": {
        "trading_enabled": {"const": false},
        "constructed": {"const": 0},
        "submitted": {"const": 0}
      },
      "additionalProperties": false
    },
    "invariants": {"type": "object", "minProperties": 1, "additionalProperties": {"const": true}},
    "failed_invariants": {"type": "array", "maxItems": 0},
    "overall": {"const": "PASS"}
  },
  "additionalProperties": false
}
