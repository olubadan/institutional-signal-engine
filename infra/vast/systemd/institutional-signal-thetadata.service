[Unit]
Description=Institutional Signal Engine ThetaData Terminal
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/start-institutional-signal-thetadata
ExecStop=-/usr/bin/docker stop --time 20 institutional-signal-thetadata
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
