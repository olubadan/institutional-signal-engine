{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PHASE4B_EVIDENCE_BUNDLE_CERT_V3",
  "type": "object",
  "required": ["certificate_version", "certificate_canonical_sha256", "evidence_kind", "acceptance_contract", "deterministic_scenario", "observed_projection_sha256", "observed", "invariants", "failed_invariants", "overall"],
  "properties": {
    "certificate_version": {"const": "PHASE4B_EVIDENCE_BUNDLE_CERT_V3"},
    "certificate_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_kind": {"const": "RUNTIME_EVIDENCE_BUNDLE_CERTIFICATE"},
    "acceptance_contract": {
      "type": "object",
      "required": ["contract_version", "canonical_sha256", "expected_run_id", "expected_epoch_memberships", "expected_clock_boundaries", "required_invariants"],
      "properties": {
        "contract_version": {"const": "PHASE4B_ACCEPTANCE_CONTRACT_V3"},
        "canonical_sha256": {"const": "da13d2b3b632913ffefafad278e9f48e6fca8b11e3341b760c001d0f0cea468d"},
        "expected_run_id": {"type": "string", "format": "uuid"},
        "expected_epoch_memberships": {"type": "array", "minItems": 3, "maxItems": 3},
        "expected_clock_boundaries": {"type": "array", "minItems": 2, "maxItems": 2},
        "required_invariants": {"type": "array", "minItems": 1}
      },
      "additionalProperties": false
    },
    "deterministic_scenario": {
      "type": "object",
      "required": ["version", "canonical_sha256"],
      "properties": {
        "version": {"const": "PHASE4B_ACCELERATED_CAUSAL_RTH_V3"},
        "canonical_sha256": {"const": "05ac756c035d8aca12fe8ff5d9016024ef814b512166c8ceecaed40a318b593f"}
      },
      "additionalProperties": false
    },
    "observed_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed": {
      "type": "object",
      "required": ["run_id", "configuration_versions", "epochs", "subscriptions", "events", "clock", "recovery", "lifecycle", "orders", "journal", "persistence", "replay"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "configuration_versions": {"type": "object"},
        "epochs": {"type": "array", "minItems": 3, "maxItems": 3},
        "subscriptions": {"type": "array", "minItems": 6},
        "events": {"type": "object", "required": ["accepted", "rejected"]},
        "clock": {"type": "object", "required": ["boundaries", "reevaluations"]},
        "recovery": {"type": "object", "required": ["disconnects", "reconnects", "restorations"]},
        "lifecycle": {"type": "array", "minItems": 6, "maxItems": 6},
        "orders": {
          "type": "object",
          "required": ["trading_enabled", "constructed", "submitted"],
          "properties": {"trading_enabled": {"const": false}, "constructed": {"const": 0}, "submitted": {"const": 0}}
        },
        "journal": {
          "type": "object",
          "required": ["record_count", "terminal_sequence", "root_digest", "seal_digest", "canonical_byte_sha256"],
          "properties": {
            "record_count": {"type": "integer", "minimum": 1},
            "terminal_sequence": {"type": "integer", "minimum": 0},
            "root_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "seal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "canonical_byte_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "persistence": {
          "type": "object",
          "required": ["contract_version", "run_id", "journal_root_digest", "journal_byte_sha256", "journal_record_count", "persistence_identity", "persistence_completed", "receipt_digest"],
          "properties": {"persistence_completed": {"const": true}, "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        },
        "replay": {
          "type": "object",
          "required": ["contract_version", "run_id", "persistence_identity", "original_root_digest", "reconstructed_root_digest", "original_byte_sha256", "reconstructed_byte_sha256", "original_record_count", "reconstructed_record_count", "original_projection_digest", "replayed_projection_digest", "exact_equality", "receipt_digest"],
          "properties": {"exact_equality": {"const": true}, "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      }
    },
    "invariants": {"type": "object", "minProperties": 1, "additionalProperties": {"const": true}},
    "failed_invariants": {"type": "array", "maxItems": 0},
    "overall": {"const": "PASS"}
  },
  "additionalProperties": false
}
